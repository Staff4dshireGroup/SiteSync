# Copy to apps/admin-app/.env and restart Expo after changes.
EXPO_PUBLIC_API_URL=http://localhost:3001/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:3001

# Must match backend XERO_REDIRECT_URI exactly. Phones cannot use localhost;
# use the computer's LAN IP or an https tunnel, and register that URI in the Xero app.
EXPO_PUBLIC_XERO_REDIRECT_URI=http://localhost:3001/api/xero/oauth/callback
