# Copy to backend/.env. Never commit real secrets.

# Postgres (Supabase: pooled URL for the app, direct URL for Prisma migrations)
DATABASE_URL=postgresql://postgres:password@localhost:5432/sitesync
DIRECT_URL=postgresql://postgres:password@localhost:5432/sitesync

PORT=3001
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Public base used when the API builds file URLs
PUBLIC_API_BASE_URL=http://localhost:3001

EMAIL_FROM=developer@sitesync.uk
RESEND_API_KEY=

# --- Xero (company OAuth). Leave blank until the developer app exists. ---
# Web app client from https://developer.xero.com/app/manage
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Must match the redirect URI registered on the Xero app, character for character.
XERO_REDIRECT_URI=http://localhost:3001/api/xero/oauth/callback
# 32+ characters. Encrypts access and refresh tokens at rest.
# Required in production when the process is not read-only. Production does not derive a key.
# Local development may omit it and derive one from JWT_SECRET.
XERO_TOKEN_ENCRYPTION_KEY=
# Optional. Space-separated. Defaults include openid, offline_access, accounting scopes, and projects.
# Reconnect after changing scopes. projects (not projects.read) is required to push time.
# XERO_SCOPES=openid profile email offline_access accounting.settings.read accounting.invoices accounting.contacts.read projects
# Optional browser redirect after the OAuth callback. Query params report success or xero_pending.
# XERO_OAUTH_SUCCESS_REDIRECT=
# Background jobs stay off unless set to true. Read-only mode forces them off.
XERO_TOKEN_REFRESH_JOB=false
# XERO_TOKEN_REFRESH_INTERVAL_MS=3600000
# Push approved timesheets to Xero only when this is true. The staging blueprint sets false.
XERO_PUSH_ON_APPROVAL=false
# Set true on the Staff4dshire staging service so it cannot write the shared database.
# SITESYNC_READ_ONLY=false
# ONBOARDING_REMINDER_JOB=false
# Task created on a Xero project when it has no "Site labour" TIME task.
# XERO_DEFAULT_TASK_NAME=Site labour
# XERO_DEFAULT_CURRENCY=GBP
# XERO_DEFAULT_TASK_RATE=0

GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=gb
SEED_ON_DEPLOY=false
